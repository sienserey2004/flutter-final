    "version": "0.2.0",
    "configurations": [
        {
            "name": "app (Chrome)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "args": [
                "--dart-define=API_BASE_URL=http://127.0.0.1:5000/api"
            ]
        },
        {
            "name": "app (Chrome, release)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "flutterMode": "release"
        },
        {
            "name": "app (Windows)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "windows"
        }
    ]
